# Homologação: copie para docker/homolog.env (fora do git). Aqui NÃO há segredo: só endereços e opções. Os segredos são ARQUIVOS em docker/segredos/ (veja docker/segredos/LEIA-ME.md).
POLARIS_AMBIENTE=homolog
POLARIS_IMAGEM=registro.exemplo.com/polaris:0.1.0
POLARIS_NOS=/srv/polaris/nos
POLARIS_CERTS=/etc/letsencrypt/live/homolog.polaris.exemplo.com
POLARIS_DOMINIO=homolog.polaris.exemplo.com
JWT_EMISSOR=https://id.exemplo.com
JWT_AUDIENCIA=polaris-homolog
JWT_JWKS_URL=https://id.exemplo.com/.well-known/jwks.json
POLARIS_SERVICOS={"loja":"http://loja:3001"}
POLARIS_LOG_NIVEL=debug
POLARIS_GRAPHQL_INTROSPECCAO=1
POLARIS_MIGRAR=1
