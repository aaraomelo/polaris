# Copie para .env (que nunca é versionado). TODOS os valores abaixo são de DESENVOLVIMENTO: troque em qualquer outro ambiente.
POSTGRES_SENHA=dev-postgres-troque
POLARIS_MIGRADOR_SENHA=dev-migrador-troque
POLARIS_APP_SENHA=dev-app-troque
# HS256 só em desenvolvimento (>= 32 caracteres). Em produção use JWT_JWKS_URL ou JWT_CHAVE_PUBLICA_JWK.
JWT_SEGREDO=dev-segredo-jwt-com-mais-de-32-caracteres
POLARIS_METRICAS_TOKEN=dev-metricas-token-16+
