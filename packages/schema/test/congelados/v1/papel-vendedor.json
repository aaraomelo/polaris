{
  "kind": "papel",
  "id": "vendedor",
  "versao": "1.0.0",
  "spec": {
    "descricao": "Atende o balcão: lê o catálogo e gerencia só os próprios pedidos.",
    "herda": ["leitor"],
    "regras": [
      { "acoes": ["listar", "obter"], "sujeitos": ["loja.produto"] },
      { "acoes": ["manage"], "sujeitos": ["loja.pedido"], "onde": { "criadoPor": "$usuario" } },
      { "acoes": ["remover"], "sujeitos": ["all"], "negar": true },
      { "acoes": ["atualizar"], "sujeitos": ["loja.cliente"], "campos": ["telefone", "email"] }
    ]
  }
}
