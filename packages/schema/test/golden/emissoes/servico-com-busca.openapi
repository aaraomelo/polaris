{
  "components": {
    "schemas": {
      "Artigo": {
        "additionalProperties": false,
        "properties": {
          "atualizadoEm": {
            "format": "date-time",
            "type": "string"
          },
          "criadoEm": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "publicado": {
            "default": true,
            "type": "boolean"
          },
          "resumo": {
            "type": "string"
          },
          "titulo": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "titulo",
          "criadoEm",
          "atualizadoEm"
        ],
        "type": "object"
      },
      "ArtigoAlteracao": {
        "additionalProperties": false,
        "properties": {
          "publicado": {
            "default": true,
            "type": "boolean"
          },
          "resumo": {
            "type": "string"
          },
          "titulo": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ArtigoEntrada": {
        "additionalProperties": false,
        "properties": {
          "publicado": {
            "default": true,
            "type": "boolean"
          },
          "resumo": {
            "type": "string"
          },
          "titulo": {
            "type": "string"
          }
        },
        "required": [
          "titulo"
        ],
        "type": "object"
      },
      "Erro": {
        "properties": {
          "erro": {
            "properties": {
              "codigo": {
                "type": "string"
              },
              "detalhes": {},
              "mensagem": {
                "type": "string"
              }
            },
            "required": [
              "codigo",
              "mensagem"
            ],
            "type": "object"
          }
        },
        "required": [
          "erro"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Gerado do schema (kind servico). Multi-tenant: o tenant vem da autenticação, nunca do corpo.",
    "title": "Serviço vitrine-busca",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/artigos": {
      "get": {
        "operationId": "listarArtigo",
        "parameters": [
          {
            "in": "query",
            "name": "titulo",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "resumo",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "publicado",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "description": "busca por palavras (até 5, todas devem aparecer), sem diferenciar maiúsculas nem acentos, nos campos declarados em `busca` da entidade",
            "in": "query",
            "name": "busca",
            "required": false,
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "pagina",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "limite",
            "required": false,
            "schema": {
              "default": 24,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Artigo"
                  },
                  "type": "array"
                }
              }
            },
            "description": "lista paginada"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            },
            "description": "requisição inválida"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            },
            "description": "conflito (duplicado ou referência)"
          }
        },
        "security": [],
        "tags": [
          "artigo"
        ],
        "x-acesso": {
          "modo": "publica"
        }
      }
    },
    "/artigos/{id}": {
      "get": {
        "operationId": "obterArtigo",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "format": "uuid",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Artigo"
                }
              }
            },
            "description": "ok"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            },
            "description": "requisição inválida"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            },
            "description": "não encontrado"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            },
            "description": "conflito (duplicado ou referência)"
          }
        },
        "security": [],
        "tags": [
          "artigo"
        ],
        "x-acesso": {
          "modo": "publica"
        }
      }
    }
  }
}
