{
  "components": {
    "schemas": {
      "Erro": {
        "properties": {
          "erro": {
            "properties": {
              "codigo": {
                "type": "string"
              },
              "detalhes": {},
              "mensagem": {
                "type": "string"
              }
            },
            "required": [
              "codigo",
              "mensagem"
            ],
            "type": "object"
          }
        },
        "required": [
          "erro"
        ],
        "type": "object"
      },
      "Produto": {
        "additionalProperties": false,
        "properties": {
          "atualizadoEm": {
            "format": "date-time",
            "type": "string"
          },
          "criadoEm": {
            "format": "date-time",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "preco": {
            "pattern": "^-?[0-9]{1,15}(\\.[0-9]{1,4})?$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "nome",
          "preco",
          "criadoEm",
          "atualizadoEm"
        ],
        "type": "object"
      },
      "ProdutoAlteracao": {
        "additionalProperties": false,
        "properties": {
          "nome": {
            "type": "string"
          },
          "preco": {
            "pattern": "^-?[0-9]{1,15}(\\.[0-9]{1,4})?$",
            "type": "string"
          }
        },
        "type": "object"
      },
      "ProdutoEntrada": {
        "additionalProperties": false,
        "properties": {
          "nome": {
            "type": "string"
          },
          "preco": {
            "pattern": "^-?[0-9]{1,15}(\\.[0-9]{1,4})?$",
            "type": "string"
          }
        },
        "required": [
          "nome",
          "preco"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Gerado do schema (kind servico). Multi-tenant: o tenant vem da autenticação, nunca do corpo.",
    "title": "Serviço catalogo",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/produtos": {
      "get": {
        "operationId": "listarProdutos",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Produto"
                }
              }
            },
            "description": "ok"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            },
            "description": "requisição inválida"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            },
            "description": "não autenticado"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            },
            "description": "sem permissão"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Erro"
                }
              }
            },
            "description": "conflito (duplicado ou referência)"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": [
          "operacoes"
        ],
        "x-permissao": "produto.ler"
      }
    }
  }
}
