{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "polaris://comum/v1",
  "title": "Definições compartilhadas",
  "$defs": {
    "identificador": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "interface": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*(/[a-z0-9._-]+)*$",
      "description": "id de interface de bloco, ex.: commerce/vitrine"
    },
    "expressao": {
      "type": "string",
      "minLength": 1,
      "description": "expressão pura (sem chaves), ex.: produtos.length > 0. Usada em se e repetir.cada"
    },
    "tipoDado": {
      "enum": [
        "texto",
        "inteiro",
        "decimal",
        "booleano",
        "data",
        "dataHora",
        "dinheiro",
        "uuid",
        "json"
      ]
    },
    "ref": {
      "type": "object",
      "required": [
        "$ref"
      ],
      "properties": {
        "$ref": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "campo": {
      "type": "object",
      "required": [
        "tipo"
      ],
      "properties": {
        "tipo": {
          "$ref": "#/$defs/tipoDado"
        },
        "obrigatorio": {
          "type": "boolean",
          "default": false
        },
        "lista": {
          "type": "boolean",
          "default": false
        },
        "padrao": {},
        "descricao": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "campos": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*$"
      },
      "additionalProperties": {
        "$ref": "#/$defs/campo"
      }
    },
    "instancia": {
      "type": "object",
      "required": [
        "bloco"
      ],
      "properties": {
        "bloco": {
          "$ref": "#/$defs/interface"
        },
        "id": {
          "type": "string"
        },
        "props": {
          "type": "object"
        },
        "slots": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/instancia"
            }
          }
        },
        "se": {
          "$ref": "#/$defs/expressao"
        },
        "repetir": {
          "type": "object",
          "required": [
            "cada",
            "como"
          ],
          "properties": {
            "cada": {
              "$ref": "#/$defs/expressao"
            },
            "como": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]*$",
              "description": "nome da variável de cada item"
            }
          },
          "additionalProperties": false
        },
        "eventos": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/$defs/acao"
            }
          },
          "description": "evento do bloco → ações executadas em sequência"
        },
        "esqueleto": {
          "$ref": "#/$defs/instancia",
          "description": "o que mostrar enquanto os dados em streaming usados por esta instância não chegam (não pode usar esses dados)"
        }
      },
      "additionalProperties": false
    },
    "template": {
      "type": "string",
      "description": "texto com bindings {expressao | formatador}; {{ e }} literais não existem: use \\{ e \\}. Um texto que é só um binding mantém o tipo do valor"
    },
    "acao": {
      "type": "object",
      "required": [
        "acao"
      ],
      "properties": {
        "acao": {
          "enum": [
            "definir",
            "executar",
            "navegar"
          ]
        },
        "estado": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$",
          "description": "definir: nome de uma entrada de spec.estado"
        },
        "valor": {
          "$ref": "#/$defs/expressao",
          "description": "definir: expressão avaliada na hora do evento (vê evento e o escopo da página)"
        },
        "dados": {
          "type": "string",
          "pattern": "^[a-z][A-Za-z0-9]*$",
          "description": "executar: nome de uma entrada de spec.dados"
        },
        "args": {
          "type": "object",
          "description": "executar: argumentos (templates; veem evento e o escopo)"
        },
        "depois": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/acao"
          },
          "description": "executar: ações após sucesso (vêem resultado)"
        },
        "emErro": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/acao"
          },
          "description": "executar: ações após falha (vêem erro)"
        },
        "para": {
          "$ref": "#/$defs/template",
          "description": "navegar: URL ou rota de destino"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "acao": {
                "const": "definir"
              }
            },
            "required": [
              "acao"
            ]
          },
          "then": {
            "properties": {
              "acao": {},
              "estado": {},
              "valor": {}
            },
            "required": [
              "estado",
              "valor"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "acao": {
                "const": "executar"
              }
            },
            "required": [
              "acao"
            ]
          },
          "then": {
            "properties": {
              "acao": {},
              "dados": {},
              "args": {},
              "depois": {},
              "emErro": {}
            },
            "required": [
              "dados"
            ],
            "additionalProperties": false
          }
        },
        {
          "if": {
            "properties": {
              "acao": {
                "const": "navegar"
              }
            },
            "required": [
              "acao"
            ]
          },
          "then": {
            "properties": {
              "acao": {},
              "para": {}
            },
            "required": [
              "para"
            ],
            "additionalProperties": false
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
