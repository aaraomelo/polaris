{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "polaris://kind/bloco/v1",
  "title": "Definição de bloco (interface + contrato)",
  "required": [
    "interface"
  ],
  "properties": {
    "interface": {
      "$ref": "polaris://comum/v1#/$defs/interface"
    },
    "titulo": {
      "type": "string",
      "description": "nome legível do bloco (catálogo)"
    },
    "descricao": {
      "type": "string",
      "description": "para que serve (catálogo)"
    },
    "exemplos": {
      "type": "array",
      "description": "usos de exemplo: viram o preview e a documentação do catálogo; são conferidos contra os slots do bloco",
      "items": {
        "type": "object",
        "required": [
          "titulo",
          "instancia"
        ],
        "additionalProperties": false,
        "properties": {
          "titulo": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "instancia": {
            "$ref": "polaris://comum/v1#/$defs/instancia"
          }
        }
      }
    },
    "extends": {
      "$ref": "polaris://comum/v1#/$defs/interface"
    },
    "props": {
      "type": "object",
      "description": "JSON Schema (type=object) das props",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "const": "object"
        }
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "aceita": {
            "type": "array",
            "items": {
              "$ref": "polaris://comum/v1#/$defs/interface"
            }
          },
          "min": {
            "type": "integer",
            "minimum": 0
          },
          "max": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "modelo": {
      "$ref": "polaris://comum/v1#/$defs/instancia",
      "description": "implementação declarativa (composição de outros blocos)"
    },
    "codigo": {
      "type": "object",
      "required": [
        "linguagem",
        "fonte"
      ],
      "description": "escape hatch: código do tenant, executado isolado. js+puro: QuickJS (WASM) calcula uma descrição de UI; iframe: <iframe sandbox> com CSP",
      "properties": {
        "linguagem": {
          "enum": [
            "js",
            "html"
          ]
        },
        "modo": {
          "enum": [
            "puro",
            "iframe"
          ],
          "description": "padrão: js → puro, html → iframe. html nunca é puro."
        },
        "fonte": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "permissoes": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 16,
          "items": {
            "type": "string",
            "pattern": "^(formularios|(rede|imagens):https://[a-z0-9]([a-z0-9.-]*[a-z0-9])?(:[0-9]{1,5})?)$"
          },
          "description": "só modo iframe: formularios, rede:https://origem, imagens:https://origem (a origem precisa estar na allowlist da plataforma)"
        },
        "altura": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4000,
          "description": "só iframe: altura em px (padrão 240)"
        }
      },
      "additionalProperties": false
    },
    "eventos": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*$"
      },
      "description": "eventos que o bloco emite (a instância liga ações a eles)",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "payload": {
            "$ref": "polaris://comum/v1#/$defs/tipoDado"
          }
        },
        "additionalProperties": false
      }
    },
    "layout": {
      "$ref": "polaris://comum/v1#/$defs/interface",
      "description": "layout-pai: este bloco, quando usado como layout, é envolvido por ele (precisa do slot conteudo)"
    }
  },
  "type": "object",
  "additionalProperties": false
}
