{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "polaris://kind/kernel/v1",
  "title": "Kernel de computação",
  "required": [
    "entradas",
    "saidas"
  ],
  "properties": {
    "entradas": {
      "$ref": "polaris://comum/v1#/$defs/campos"
    },
    "saidas": {
      "$ref": "polaris://comum/v1#/$defs/campos"
    },
    "dominio": {
      "type": "object",
      "description": "limites de avaliação",
      "properties": {
        "maxElementos": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216,
          "description": "maior n aceito (padrão 1048576)"
        }
      }
    },
    "restricoes": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 500
      },
      "description": "precondições sobre as entradas ESCALARES (expressões booleanas); violada → o kernel não executa"
    },
    "emissoes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "alvo"
        ],
        "properties": {
          "alvo": {
            "enum": [
              "glsl",
              "wasm",
              "ptx",
              "js"
            ]
          },
          "backend": {
            "type": "string"
          },
          "fonte": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "tolerancia": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "relativa": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.1
        },
        "absoluta": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "description": "diferença aceita entre alvos na paridade (a GPU pode fundir operações); js, wasm e ptx são exatos e ignoram"
    },
    "corpo": {
      "type": "object",
      "required": [
        "saidas"
      ],
      "additionalProperties": false,
      "description": "mapa elemento a elemento na linguagem de expressões; `i` e `n` existem; entrada `lista` é lida no elemento i, as demais são escalares",
      "properties": {
        "locais": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "nome",
              "valor"
            ],
            "additionalProperties": false,
            "properties": {
              "nome": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9]*$"
              },
              "valor": {
                "type": "string",
                "maxLength": 500
              }
            }
          }
        },
        "saidas": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 4,
          "propertyNames": {
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 500
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "description": "Kernel de computação: mapa elemento a elemento, independente de alvo (js, wasm, glsl, ptx). Ver docs/computacao.md e ADR 0009."
}
