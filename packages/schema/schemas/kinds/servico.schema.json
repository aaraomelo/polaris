{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "polaris://kind/servico/v1",
  "title": "Microsserviço",
  "required": [
    "entidades",
    "operacoes"
  ],
  "properties": {
    "entidades": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "campos"
        ],
        "properties": {
          "campos": {
            "$ref": "polaris://comum/v1#/$defs/campos"
          },
          "indices": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "unicos": {
            "type": "array",
            "description": "chaves únicas POR TENANT (ex.: [[\"sku\"]]); violação vira 409",
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "crud": {
            "type": "object",
            "required": [
              "caminho"
            ],
            "additionalProperties": false,
            "description": "gera as rotas padrão da entidade (listar, obter, criar, atualizar, remover)",
            "properties": {
              "caminho": {
                "type": "string",
                "pattern": "^/[a-z0-9/-]*$",
                "description": "coleção, ex.: /produtos (o item é /produtos/{id})"
              },
              "operacoes": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "enum": [
                    "listar",
                    "obter",
                    "criar",
                    "atualizar",
                    "remover"
                  ]
                },
                "description": "padrão: as cinco"
              },
              "permissao": {
                "type": "string",
                "description": "publica (sem autenticação) | autenticada (qualquer autenticado) | qualquer outro valor, inclusive o padrão, é protegida: decidida pelas regras dos papéis (nunca abre por engano)"
              }
            }
          },
          "busca": {
            "type": "object",
            "required": [
              "campos"
            ],
            "additionalProperties": false,
            "description": "habilita o parâmetro `busca` na listagem gerada: palavras (até 5, todas devem aparecer) nos campos de texto indicados, sem diferenciar maiúsculas nem acentos; `modo: aproximada` acrescenta tolerância a erros de digitação e relevância",
            "properties": {
              "campos": {
                "type": "array",
                "minItems": 1,
                "maxItems": 5,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z0-9]*$"
                }
              },
              "modo": {
                "enum": [
                  "exata",
                  "aproximada"
                ],
                "default": "exata",
                "description": "exata: trechos de palavras, sem acento nem maiúsculas. aproximada: também erros de digitação e ordena por RELEVÂNCIA, com índice trigrama (exige a extensão pg_trgm no Postgres)"
              }
            }
          },
          "escopo": {
            "enum": [
              "usuario"
            ],
            "description": "`usuario`: cada registro pertence a quem o criou (coluna `dono`, preenchida pelo servidor com o usuário do token); listar, obter, atualizar e remover só alcançam os registros do próprio usuário, além do tenant. Exige crud protegido (nada de `publica`)."
          }
        },
        "additionalProperties": false
      },
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*$"
      }
    },
    "operacoes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "metodo",
          "caminho"
        ],
        "properties": {
          "metodo": {
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE"
            ]
          },
          "caminho": {
            "type": "string",
            "pattern": "^/"
          },
          "entrada": {
            "$ref": "polaris://comum/v1#/$defs/campos"
          },
          "saida": {
            "type": "string",
            "description": "entidade ou evento"
          },
          "permissao": {
            "type": "string",
            "description": "publica (sem autenticação) | autenticada (qualquer autenticado) | qualquer outro valor, inclusive o padrão, é protegida: decidida pelas regras dos papéis (nunca abre por engano)"
          },
          "publica": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "eventos publicados"
          },
          "lista": {
            "type": "boolean",
            "default": false,
            "description": "a saída é uma lista de `saida` (com paginação)"
          }
        },
        "additionalProperties": false
      },
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*$"
      }
    },
    "consome": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "eventos consumidos"
    },
    "multitenant": {
      "const": true,
      "default": true,
      "description": "sempre true: toda entidade tem tenantId"
    }
  },
  "type": "object",
  "additionalProperties": false
}
