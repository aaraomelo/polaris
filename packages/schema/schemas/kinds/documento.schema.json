{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "polaris://kind/documento/v1",
  "title": "Documento (PDF/impressão)",
  "required": [
    "tamanho",
    "blocos"
  ],
  "properties": {
    "tamanho": {
      "enum": [
        "A4",
        "A5",
        "Letter"
      ]
    },
    "orientacao": {
      "enum": [
        "retrato",
        "paisagem"
      ],
      "default": "retrato"
    },
    "margem": {
      "type": "object",
      "additionalProperties": false,
      "description": "em MILÍMETROS (padrão 12)",
      "properties": {
        "topo": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "direita": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "baixo": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "esquerda": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "fonte": {
      "type": "string"
    },
    "rodape": {
      "$ref": "polaris://comum/v1#/$defs/template"
    },
    "blocos": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/bloco"
      },
      "description": "blocos empilhados em fluxo, paginados automaticamente; texto e valores aceitam bindings seguros `{caminho | filtro}`"
    },
    "titulo": {
      "$ref": "polaris://comum/v1#/$defs/template",
      "description": "título do documento (metadados do PDF e <title> do HTML)"
    },
    "dados": {
      "type": "object",
      "maxProperties": 40,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][A-Za-z0-9]{0,30}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "tipo": {
            "enum": [
              "texto",
              "numero",
              "dinheiro",
              "data",
              "dataHora",
              "booleano",
              "json",
              "lista"
            ]
          },
          "descricao": {
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "tipo"
        ]
      },
      "description": "os dados que o documento espera (nome → tipo). Todo binding precisa começar por um destes nomes: assim um erro de digitação é acusado na validação, não vira texto em branco no papel"
    }
  },
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "bloco": {
      "type": "object",
      "required": [
        "tipo"
      ],
      "properties": {
        "tipo": {
          "enum": [
            "espaco",
            "barraSecao",
            "paragrafo",
            "campo",
            "colunas",
            "tabela",
            "resumo",
            "assinaturas",
            "imagem"
          ]
        },
        "se": {
          "type": "string",
          "pattern": "^!?[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$",
          "maxLength": 200,
          "description": "o bloco só aparece se este caminho dos dados for verdadeiro (texto não vazio, número ≠ 0, lista não vazia); `!caminho` nega"
        },
        "repetir": {
          "type": "object",
          "required": [
            "cada",
            "como"
          ],
          "additionalProperties": false,
          "properties": {
            "cada": {
              "type": "string",
              "pattern": "^!?[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$",
              "maxLength": 200
            },
            "como": {
              "type": "string",
              "pattern": "^[a-z][A-Za-z0-9]{0,30}$"
            },
            "limite": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          "description": "repete o bloco para cada item da lista `cada`; dentro dele, `como` nomeia o item"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "espaco"
              }
            },
            "required": [
              "tipo"
            ]
          },
          "then": {
            "properties": {
              "altura": {
                "type": "number",
                "minimum": 0,
                "maximum": 400
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "barraSecao"
              }
            },
            "required": [
              "tipo"
            ]
          },
          "then": {
            "properties": {
              "texto": {
                "$ref": "polaris://comum/v1#/$defs/template"
              },
              "variante": {
                "enum": [
                  "titulo",
                  "secao"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "paragrafo"
              }
            },
            "required": [
              "tipo"
            ]
          },
          "then": {
            "properties": {
              "texto": {
                "$ref": "polaris://comum/v1#/$defs/template"
              },
              "tamanho": {
                "type": "number",
                "minimum": 4,
                "maximum": 72
              },
              "peso": {
                "enum": [
                  "normal",
                  "negrito"
                ]
              },
              "cor": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              },
              "alinhamento": {
                "enum": [
                  "esquerda",
                  "centro",
                  "direita"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "campo"
              }
            },
            "required": [
              "tipo"
            ]
          },
          "then": {
            "properties": {
              "rotulo": {
                "$ref": "polaris://comum/v1#/$defs/template"
              },
              "valor": {
                "$ref": "polaris://comum/v1#/$defs/template"
              },
              "estiloValor": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "tamanho": {
                    "type": "number",
                    "minimum": 4,
                    "maximum": 72
                  },
                  "peso": {
                    "enum": [
                      "normal",
                      "negrito"
                    ]
                  },
                  "cor": {
                    "type": "string",
                    "pattern": "^#[0-9a-fA-F]{6}$"
                  },
                  "alinhamento": {
                    "enum": [
                      "esquerda",
                      "centro",
                      "direita"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "colunas"
              }
            },
            "required": [
              "tipo"
            ]
          },
          "then": {
            "properties": {
              "colunas": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "flex": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 20
                    },
                    "blocos": {
                      "type": "array",
                      "maxItems": 50,
                      "items": {
                        "$ref": "#/$defs/bloco"
                      }
                    }
                  },
                  "required": [
                    "blocos"
                  ]
                }
              },
              "espacamento": {
                "type": "number",
                "minimum": 0,
                "maximum": 60
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "tabela"
              }
            },
            "required": [
              "tipo"
            ]
          },
          "then": {
            "properties": {
              "colunas": {
                "type": "array",
                "minItems": 1,
                "maxItems": 12,
                "items": {
                  "type": "object",
                  "required": [
                    "cabecalho"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "cabecalho": {
                      "$ref": "polaris://comum/v1#/$defs/template"
                    },
                    "flex": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 50
                    },
                    "alinhamento": {
                      "enum": [
                        "esquerda",
                        "centro",
                        "direita"
                      ]
                    }
                  }
                }
              },
              "linhas": {
                "type": "array",
                "maxItems": 1000,
                "items": {
                  "type": "array",
                  "maxItems": 12,
                  "items": {
                    "oneOf": [
                      {
                        "$ref": "polaris://comum/v1#/$defs/template"
                      },
                      {
                        "type": "object",
                        "required": [
                          "principal"
                        ],
                        "additionalProperties": false,
                        "properties": {
                          "principal": {
                            "$ref": "polaris://comum/v1#/$defs/template"
                          },
                          "secundario": {
                            "$ref": "polaris://comum/v1#/$defs/template"
                          },
                          "alinhamento": {
                            "enum": [
                              "esquerda",
                              "centro",
                              "direita"
                            ]
                          },
                          "peso": {
                            "enum": [
                              "normal",
                              "negrito"
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              },
              "linhasDe": {
                "type": "object",
                "required": [
                  "cada",
                  "como",
                  "celulas"
                ],
                "additionalProperties": false,
                "properties": {
                  "cada": {
                    "type": "string",
                    "pattern": "^!?[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$",
                    "maxLength": 200
                  },
                  "como": {
                    "type": "string",
                    "pattern": "^[a-z][A-Za-z0-9]{0,30}$"
                  },
                  "limite": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2000
                  },
                  "celulas": {
                    "type": "array",
                    "maxItems": 12,
                    "items": {
                      "oneOf": [
                        {
                          "$ref": "polaris://comum/v1#/$defs/template"
                        },
                        {
                          "type": "object",
                          "required": [
                            "principal"
                          ],
                          "additionalProperties": false,
                          "properties": {
                            "principal": {
                              "$ref": "polaris://comum/v1#/$defs/template"
                            },
                            "secundario": {
                              "$ref": "polaris://comum/v1#/$defs/template"
                            },
                            "alinhamento": {
                              "enum": [
                                "esquerda",
                                "centro",
                                "direita"
                              ]
                            },
                            "peso": {
                              "enum": [
                                "normal",
                                "negrito"
                              ]
                            }
                          }
                        }
                      ]
                    }
                  }
                },
                "description": "uma linha por item da lista; `celulas` é o molde da linha"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "resumo"
              }
            },
            "required": [
              "tipo"
            ]
          },
          "then": {
            "properties": {
              "linhas": {
                "type": "array",
                "minItems": 1,
                "maxItems": 20,
                "items": {
                  "type": "object",
                  "required": [
                    "rotulo",
                    "valor"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "rotulo": {
                      "$ref": "polaris://comum/v1#/$defs/template"
                    },
                    "valor": {
                      "$ref": "polaris://comum/v1#/$defs/template"
                    },
                    "forte": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "larguraFracao": {
                "type": "number",
                "minimum": 0.2,
                "maximum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "assinaturas"
              }
            },
            "required": [
              "tipo"
            ]
          },
          "then": {
            "properties": {
              "itens": {
                "type": "array",
                "minItems": 1,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "rotulo"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "rotulo": {
                      "$ref": "polaris://comum/v1#/$defs/template"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "tipo": {
                "const": "imagem"
              }
            },
            "required": [
              "tipo"
            ]
          },
          "then": {
            "properties": {
              "src": {
                "$ref": "polaris://comum/v1#/$defs/template"
              },
              "largura": {
                "type": "number",
                "minimum": 1,
                "maximum": 600
              },
              "altura": {
                "type": "number",
                "minimum": 1,
                "maximum": 600
              },
              "alinhamento": {
                "enum": [
                  "esquerda",
                  "centro",
                  "direita"
                ]
              },
              "alt": {
                "$ref": "polaris://comum/v1#/$defs/template"
              }
            }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  },
  "description": "Documento em fluxo (PDF/impressão): blocos que empilham e paginam, com dados vinculados por interpolação segura. O esquema 1 do kind era um esboço (\"detalhado no E9\"); o detalhamento dos blocos entrou sem novo major porque nenhum documento de produção existia (ver docs/documentos.md)."
}
