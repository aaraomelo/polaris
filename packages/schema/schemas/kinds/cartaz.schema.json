                "additionalProperties": false,
                "required": [
                  "texto"
                ],
                "properties": {
                  "texto": {
                    "type": "string",
                    "maxLength": 40,
                    "description": "ex.: {produto.unidade}; aparece miúda sob os centavos"
                  },
                  "escala": {
                    "type": "number",
                    "minimum": 0.05,
                    "maximum": 1,
                    "default": 0.22,
                    "description": "em relação ao tamanho dos centavos"
                  }
                }
              },
              "riscado": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "espessura": {
                    "type": "number",
                    "minimum": 0.1,
                    "maximum": 50,
                    "default": 2
                  },
                  "cor": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    },
                    "minItems": 3,
                    "maxItems": 3,
                    "description": "[R, G, B], 0 a 255"
                  }
                },
                "description": "traço em diagonal sobre o preço (preço antigo)"
              },
              "cores": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "se",
                    "cor"
                  ],
                  "properties": {
                    "se": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "cor": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      },
                      "minItems": 3,
                      "maxItems": 3,
                      "description": "[R, G, B], 0 a 255"
                    }
                  }
                },
                "description": "cor condicional: a primeira cuja condição for verdadeira substitui `cor`"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tipo",
              "caixa"
            ],
            "properties": {
              "tipo": {
                "const": "validade"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][A-Za-z0-9_-]{0,40}$",
                "description": "identificador do elemento (único na peça)"
              },
              "se": {
                "type": "string",
                "maxLength": 300,
                "description": "condição sobre os dados: `caminho`, `!caminho`, `caminho == \"x\"`, `caminho != \"x\"` ou `caminho em [\"a\", \"b\"]`"
              },
              "caixa": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "topo",
                  "largura",
                  "altura"
                ],
                "properties": {
                  "topo": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 2,
                    "description": "fração da ALTURA da peça"
                  },
                  "esquerda": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 2,
                    "description": "fração da LARGURA da peça (a partir da esquerda)"
                  },
                  "direita": {
                    "type": "number",
                    "minimum": -1,
                    "maximum": 2,
                    "description": "fração da LARGURA da peça (a partir da direita); use esquerda OU direita"
                  },
                  "largura": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 2
                  },
                  "altura": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 2
                  }
                },
                "description": "a caixa do elemento, em FRAÇÕES da peça (0 a 1): o mesmo layout serve a todos os tamanhos"
              },
              "rotacao": {
                "type": "number",
                "minimum": -360,
                "maximum": 360,
                "description": "graus, ANTI-HORÁRIO, em torno do meio da borda esquerda da caixa"
              },
              "alinhaH": {
                "enum": [
                  "esquerda",
                  "centro",
                  "direita"
                ],
                "default": "esquerda"
              },
              "alinhaV": {
                "enum": [
                  "topo",
                  "meio",
                  "base"
                ],
                "default": "topo"
              },
              "cor": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "minItems": 3,
                "maxItems": 3,
                "description": "[R, G, B], 0 a 255"
              },
              "fonte": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "familia": {
                    "type": "string",
                    "maxLength": 40
                  },
                  "peso": {
                    "enum": [
                      "normal",
                      "negrito"
                    ]
                  }
                }
              },
              "tamanho": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "min": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 400
                  },
                  "max": {
                    "type": "number",
                    "minimum": 1,
                    "maximum": 400
                  }
                },
                "description": "limites do ajuste, em pt (padrão 6 a 300)"
              },
              "rotulo": {
                "type": "string",
                "maxLength": 60,
                "description": "padrão: VALIDADE"
              },
              "data": {
                "type": "string",
                "maxLength": 40,
                "description": "modelo com a data dd/mm/aaaa, ex.: {produto.validade}; vazia = campos em branco para escrever à mão"
              },
              "espessura": {
                "type": "number",
                "minimum": 0.1,
                "maximum": 20,
                "default": 2,
                "description": "traço dos sublinhados, em pt"
              },
              "cores": {
                "type": "array",
                "maxItems": 10,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "se",
                    "cor"
                  ],
                  "properties": {
                    "se": {
                      "type": "string",
                      "maxLength": 300
                    },
                    "cor": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 255
                      },
                      "minItems": 3,
                      "maxItems": 3,
                      "description": "[R, G, B], 0 a 255"
                    }
                  }
                },
                "description": "cor condicional: a primeira cuja condição for verdadeira substitui `cor`"
              }
            }
          }
        ]
      }
    },
    "tamanhos": {
      "type": "array",
      "items": {
        "enum": [
          "A4",
          "A5",
          "A6",
          "A7"
        ]
      },
      "uniqueItems": true,
      "minItems": 1,
      "description": "os tamanhos a que este layout serve (as caixas são frações: o mesmo desenho vale para todos); `tamanho` é o padrão e deve estar na lista"
    },
    "calculos": {
      "type": "object",
      "maxProperties": 40,
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]{0,30}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "funcao",
          "args"
        ],
        "properties": {
          "funcao": {
            "enum": [
              "identidade",
              "diferenca",
              "diferencaPercentual",
              "percentual",
              "desconto",
              "parcela",
              "arredonda"
            ]
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z0-9_]+)*$"
            },
            "minItems": 1,
            "maxItems": 2,
            "description": "caminhos nos dados (valores decimais em texto)"
          },
          "padrao": {
            "type": "string",
            "maxLength": 40,
            "description": "valor se algum argumento não for número (sem isso, é erro)"
          }
        }
      },
      "description": "valores derivados, em decimal exato; ficam em {calculo.nome}. diferenca(a,b)=a−b; diferencaPercentual(a,b)=piso de (a−b)/a em %; percentual (2 casas); desconto(preço, %); parcela(preço, n)=piso em centavos; arredonda"
    },
    "exemplo": {
      "type": "object",
      "description": "dados de EXEMPLO da peça (prévia do Studio e testes); nunca usados na geração real"
    }
  }
}
