{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "polaris://kind/tema/v1",
  "title": "Tema (design tokens)",
  "required": [
    "tokens"
  ],
  "properties": {
    "tokens": {
      "type": "object",
      "properties": {
        "cor": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "tipografia": {
          "type": "object"
        },
        "espacamento": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "raio": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "layout": {
          "type": "object",
          "description": "larguras do conteúdo: `largura`, `larguraEstreita` e `larguraLarga` (ex.: 80rem), usadas por layout/contido",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "cabecalho": {
          "type": "object",
          "description": "cabeçalho (site/cabecalho): `altura`, `fundo`, `desfoque` (ex.: blur(4px)), `borda`, `marcaTamanho`, `marcaPeso`, `linkTamanho`, `linkEspacamento`, `linkCaixa`, `linkCor`, `sublinhaHover` (1 liga o sublinhado animado). Cada valor vira variável CSS com fallback no CSS base",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "rodape": {
          "type": "object",
          "description": "rodapé (site/rodape): `fundo`, `texto`, `link`, `borda`, `marcaTamanho`",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "movimento": {
          "type": "object",
          "description": "transições: `rapido` (cor, fundo, borda), `sublinha`, `zoomDuracao` e `zoomCartao` (escala da foto no hover), `entrada` (duração da entrada da capa), `zoomCapa` (escala final do zoom lento). Sem estes tokens não há transição",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "botao": {
          "type": "object",
          "description": "botões e links de botão: `caixa` (uppercase), `espacamento` (letter-spacing), `tamanho` e `peso`",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "modos": {
      "type": "object",
      "description": "modo → sobrescritas de tokens (ex.: escuro)",
      "additionalProperties": {
        "type": "object"
      }
    },
    "seguirSistema": {
      "type": "boolean",
      "description": "false: o modo escuro só vale com data-modo=\"escuro\" no <html>, sem seguir a preferência do sistema (padrão: true)"
    }
  },
  "type": "object",
  "additionalProperties": false
}
