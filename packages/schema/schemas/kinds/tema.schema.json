{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "polaris://kind/tema/v1",
  "title": "Tema (design tokens)",
  "required": [
    "tokens"
  ],
  "properties": {
    "tokens": {
      "type": "object",
      "properties": {
        "cor": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "tipografia": {
          "type": "object"
        },
        "espacamento": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "raio": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "layout": {
          "type": "object",
          "description": "larguras do conteúdo: `largura`, `larguraEstreita` e `larguraLarga` (ex.: 80rem), usadas por layout/contido",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "modos": {
      "type": "object",
      "description": "modo → sobrescritas de tokens (ex.: escuro)",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "type": "object",
  "additionalProperties": false
}
