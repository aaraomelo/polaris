{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "polaris://kind/tema/v1",
  "title": "Tema (design tokens)",
  "required": [
    "tokens"
  ],
  "properties": {
    "tokens": {
      "type": "object",
      "properties": {
        "cor": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "tipografia": {
          "type": "object"
        },
        "espacamento": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "raio": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "layout": {
          "type": "object",
          "description": "larguras e recuo do conteúdo: `largura`, `larguraEstreita` e `larguraLarga` (ex.: 80rem) e `recuo`/`recuoEstreito` (recuo lateral), usados por layout/contido",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "cabecalho": {
          "type": "object",
          "description": "cabeçalho (site/cabecalho): `altura`, `recuoX` (recuo lateral; ex.: alinhar ao contêiner), `fundo`, `desfoque` (ex.: blur(4px)), `borda`, `marcaTamanho`, `marcaPeso`, `linkTamanho`, `linkEspacamento`, `linkCaixa`, `linkCor`, `sublinhaHover` (1 liga o sublinhado animado). Cada valor vira variável CSS com fallback no CSS base",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "rodape": {
          "type": "object",
          "description": "rodapé (site/rodape): `fundo`, `texto`, `suave` (texto secundário), `link`, `borda`, `marcaTamanho`, `marcaPeso`, `marcaEspacamento`, `descricaoTamanho`, `tituloTamanho`, `tituloPeso`, `tituloEspacamento`, `tituloCaixa`",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "movimento": {
          "type": "object",
          "description": "transições: `rapido` (cor, fundo, borda), `sublinha`, `zoomDuracao` e `zoomCartao` (escala da foto do cartão no hover), `fotoAlt` (fade da 2ª foto), `rotulo` (rótulo sobre a foto), `zoomFaixa`, `zoomFaixaDuracao`, `faixaVeu`, `faixaVeuDuracao`, `faixaTexto` e `faixaElevacao` (faixa `zoom`), `entrada` (entrada do texto da capa), `zoomCapa` (zoom lento da capa). Sem estes tokens não há transição",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "botao": {
          "type": "object",
          "description": "botões e links de botão: `caixa` (uppercase), `espacamento` (letter-spacing), `tamanho` e `peso`",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "cartao": {
          "type": "object",
          "description": "cartão de produto: `tituloTamanho`, `tituloAltura`, `tituloEspacamento`, `tituloHover`, `categoriaCor`, `categoriaTamanho`, `categoriaEspacamento`, `descricaoTamanho`, `precoTamanho`, `precoPeso`, `precoEspacamento`, `seloFundo`, `seloTexto`, `seloMargem`",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "capa": {
          "type": "object",
          "description": "capa (layout/destaque com `capa`): `indicador` é o texto do indicador de rolagem entre aspas (ex.: \"Rolar\"); sem ele não há indicador",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "abas": {
          "type": "object",
          "description": "abas de navegação (site/abas): `gap`, `altura`, `recuoX`, `recuoY`, `tamanho`, `peso`, `espacamento`, `caixa`, `cor`, `corHover`, `fundoHover`, `corAtiva`, `fundoAtiva`",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "barra": {
          "type": "object",
          "description": "barra fixa (layout com marca `barra-fixa`): `topo` (padrão: a altura do cabeçalho), `fundo`, `desfoque`, `borda`, `recuoX`, `recuoY`, `gap`, `rotuloTamanho`, `rotuloEspacamento`, `rotuloCaixa`, `rotuloCor`",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        },
        "selecao": {
          "type": "object",
          "description": "seletor (entrada/selecao): `largura`, `altura`, `tamanho`, `espacamento`, `fundo`",
          "additionalProperties": {
            "type": [
              "number",
              "string"
            ]
          },
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        }
      },
      "additionalProperties": false
    },
    "modos": {
      "type": "object",
      "description": "modo → sobrescritas de tokens (ex.: escuro)",
      "additionalProperties": {
        "type": "object"
      }
    },
    "seguirSistema": {
      "type": "boolean",
      "description": "false: o modo escuro só vale com data-modo=\"escuro\" no <html>, sem seguir a preferência do sistema (padrão: true)"
    },
    "fontes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "description": "fontes embutidas na plataforma que o tema usa (ex.: cormorant-garamond, inter): o servidor emite o @font-face e serve o arquivo da própria origem. Nome desconhecido é ignorado"
    }
  },
  "type": "object",
  "additionalProperties": false
}
