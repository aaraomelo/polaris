{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "polaris://kind/pagina/v1",
  "title": "Página",
  "required": [
    "rota",
    "raiz"
  ],
  "properties": {
    "rota": {
      "type": "string",
      "pattern": "^/"
    },
    "titulo": {
      "$ref": "polaris://comum/v1#/$defs/template"
    },
    "layout": {
      "$ref": "polaris://comum/v1#/$defs/interface"
    },
    "dados": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*$"
      },
      "description": "nome da variável → id do nó dados (texto) ou { dados, args } com argumentos (templates)",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "required": [
              "dados"
            ],
            "properties": {
              "dados": {
                "type": "string"
              },
              "args": {
                "type": "object"
              },
              "stream": {
                "type": "boolean",
                "default": false,
                "description": "true: não bloqueia o primeiro byte; as instâncias que usam o valor aparecem quando ele chegar (Suspense)"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "raiz": {
      "$ref": "polaris://comum/v1#/$defs/instancia"
    },
    "guarda": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "permissões exigidas (CASL)"
    },
    "estado": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][A-Za-z0-9]*$"
      },
      "description": "estado local da página (variável `estado.<nome>`)",
      "additionalProperties": {
        "type": "object",
        "required": [
          "tipo"
        ],
        "properties": {
          "tipo": {
            "$ref": "polaris://comum/v1#/$defs/tipoDado"
          },
          "inicial": {},
          "lista": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "type": "object",
  "additionalProperties": false
}
