{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "polaris://kind/tenant/v1",
  "title": "Tenant",
  "required": [
    "alias",
    "segmento"
  ],
  "properties": {
    "alias": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,30}[a-z0-9])?$"
    },
    "nome": {
      "type": "string"
    },
    "segmento": {
      "enum": [
        "varejo",
        "servicos",
        "alimentos",
        "educacao",
        "saude",
        "outro"
      ]
    },
    "modulos": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "tema": {
      "type": "string"
    },
    "dominios": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "paginas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "idiomas": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
      }
    },
    "idiomaPadrao": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "rotaLogin": {
      "type": "string",
      "pattern": "^/"
    },
    "paginaNegado": {
      "type": "string"
    },
    "paginaNaoEncontrada": {
      "type": "string"
    },
    "redirecionamentos": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "de",
          "para"
        ],
        "properties": {
          "de": {
            "type": "string",
            "pattern": "^/"
          },
          "para": {
            "type": "string",
            "pattern": "^/"
          },
          "status": {
            "enum": [
              301,
              302,
              307,
              308
            ],
            "default": 301
          }
        },
        "additionalProperties": false
      }
    }
  },
  "type": "object",
  "additionalProperties": false
}
