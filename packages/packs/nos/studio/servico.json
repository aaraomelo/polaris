{
  "kind": "servico",
  "id": "studio",
  "versao": "1.0.0",
  "estatuto": "publicado",
  "spec": {
    "entidades": {
      "catalogoNos": {
        "campos": {
          "nos": {
            "tipo": "json",
            "lista": false,
            "descricao": "versões das cabeças do tenant: kind, id, seq, autor, nota, criadoEm"
          },
          "base": {
            "tipo": "json",
            "descricao": "ids do core/segmento por kind"
          }
        }
      },
      "catalogoBlocos": {
        "campos": {
          "blocos": {
            "tipo": "json",
            "descricao": "cada bloco: id, titulo, props (JSON Schema) e slots"
          }
        }
      },
      "noAberto": {
        "campos": {
          "origem": {
            "tipo": "texto"
          },
          "seq": {
            "tipo": "inteiro"
          },
          "no": {
            "tipo": "json"
          }
        }
      },
      "versaoSalva": {
        "campos": {
          "versao": {
            "tipo": "json"
          },
          "novo": {
            "tipo": "booleano"
          }
        }
      },
      "restaurado": {
        "campos": {
          "ok": {
            "tipo": "booleano"
          }
        }
      },
      "historicoNo": {
        "campos": {
          "versoes": {
            "tipo": "json"
          }
        }
      },
      "versaoDoNo": {
        "campos": {
          "meta": {
            "tipo": "json"
          },
          "no": {
            "tipo": "json"
          }
        }
      },
      "comparacao": {
        "campos": {
          "diff": {
            "tipo": "json"
          }
        }
      },
      "listaComentarios": {
        "campos": {
          "comentarios": {
            "tipo": "json"
          }
        }
      },
      "comentarioCriado": {
        "campos": {
          "comentario": {
            "tipo": "json"
          }
        }
      },
      "comentarioResolvido": {
        "campos": {
          "ok": {
            "tipo": "booleano"
          }
        }
      },
      "previa": {
        "campos": {
          "ok": {
            "tipo": "booleano"
          },
          "html": {
            "tipo": "texto"
          },
          "erros": {
            "tipo": "json"
          },
          "avisos": {
            "tipo": "json",
            "descricao": "contraste baixo no tema (par, modo, razão, mínimo)"
          },
          "problemas": {
            "tipo": "json",
            "descricao": "formulário: o que a validação do nó reprova (schema, referências, estrutura e expressões); lista vazia = nó coerente"
          }
        }
      },
      "publicado": {
        "campos": {
          "ok": {
            "tipo": "booleano"
          },
          "release": {
            "tipo": "inteiro"
          }
        }
      },
      "siteConfig": {
        "campos": {
          "tema": {
            "tipo": "texto"
          },
          "temas": {
            "tipo": "json"
          },
          "configuravel": {
            "tipo": "booleano"
          }
        }
      },
      "siteSalvo": {
        "campos": {
          "ok": {
            "tipo": "booleano"
          },
          "tema": {
            "tipo": "texto"
          },
          "versao": {
            "tipo": "inteiro"
          }
        }
      },
      "listaReleases": {
        "campos": {
          "producao": {
            "tipo": "inteiro"
          },
          "anterior": {
            "tipo": "inteiro"
          },
          "releases": {
            "tipo": "json"
          }
        }
      },
      "voltou": {
        "campos": {
          "ok": {
            "tipo": "booleano"
          },
          "producao": {
            "tipo": "inteiro"
          },
          "anterior": {
            "tipo": "inteiro"
          }
        }
      },
      "diffReleases": {
        "campos": {
          "adicionados": {
            "tipo": "json"
          },
          "removidos": {
            "tipo": "json"
          },
          "alterados": {
            "tipo": "json"
          }
        }
      },
      "linkPreview": {
        "campos": {
          "caminho": {
            "tipo": "texto"
          },
          "release": {
            "tipo": "inteiro"
          },
          "expiraEmHoras": {
            "tipo": "inteiro"
          }
        }
      },
      "diagrama": {
        "campos": {
          "ok": {
            "tipo": "booleano"
          },
          "html": {
            "tipo": "texto",
            "descricao": "documento do diagrama (SVG), para o quadro isolado"
          },
          "resumo": {
            "tipo": "json",
            "descricao": "quantos blocos/nós/ligações, se foi cortado e os avisos (ex.: link para rota sem página)"
          }
        }
      },
      "listaAtivos": {
        "campos": {
          "ativos": {
            "tipo": "json",
            "descricao": "imagens do tenant: id (sha-256), nome, tipo, largura, altura, tamanho, caminho"
          }
        }
      },
      "ativoEnviado": {
        "campos": {
          "ativo": {
            "tipo": "json"
          },
          "novo": {
            "tipo": "booleano"
          },
          "removidos": {
            "tipo": "inteiro",
            "descricao": "bytes de metadados (EXIF, XMP, comentários) tirados do arquivo"
          }
        }
      },
      "ativoRemovido": {
        "campos": {
          "ok": {
            "tipo": "booleano"
          }
        }
      }
    },
    "operacoes": {
      "listarNos": {
        "metodo": "GET",
        "caminho": "/nos",
        "saida": "catalogoNos",
        "permissao": "studio"
      },
      "listarBlocos": {
        "metodo": "GET",
        "caminho": "/blocos",
        "saida": "catalogoBlocos",
        "permissao": "studio"
      },
      "abrirNo": {
        "metodo": "GET",
        "caminho": "/nos/:kind/:id",
        "entrada": {
          "kind": {
            "tipo": "texto",
            "obrigatorio": true
          },
          "id": {
            "tipo": "texto",
            "obrigatorio": true
          }
        },
        "saida": "noAberto",
        "permissao": "studio"
      },
      "salvarNo": {
        "metodo": "PUT",
        "caminho": "/nos/:kind/:id",
        "entrada": {
          "kind": {
            "tipo": "texto",
            "obrigatorio": true
          },
          "id": {
            "tipo": "texto",
            "obrigatorio": true
          },
          "no": {
            "tipo": "json",
            "obrigatorio": true
          },
          "baseSeq": {
            "tipo": "json"
          },
          "nota": {
            "tipo": "texto"
          }
        },
        "saida": "versaoSalva",
        "permissao": "studio"
      },
      "restaurarPadrao": {
        "metodo": "DELETE",
        "caminho": "/nos/:kind/:id",
        "entrada": {
          "kind": {
            "tipo": "texto",
            "obrigatorio": true
          },
          "id": {
            "tipo": "texto",
            "obrigatorio": true
          }
        },
        "saida": "restaurado",
        "permissao": "studio"
      },
      "listarVersoes": {
        "metodo": "GET",
        "caminho": "/historico/:kind/:id",
        "entrada": {
          "kind": {
            "tipo": "texto",
            "obrigatorio": true
          },
          "id": {
            "tipo": "texto",
            "obrigatorio": true
          }
        },
        "saida": "historicoNo",
        "permissao": "studio"
      },
      "abrirVersao": {
        "metodo": "GET",
        "caminho": "/versao/:kind/:id",
        "entrada": {
          "kind": {
            "tipo": "texto",
            "obrigatorio": true
          },
          "id": {
            "tipo": "texto",
            "obrigatorio": true
          },
          "seq": {
            "tipo": "inteiro",
            "obrigatorio": true
          }
        },
        "saida": "versaoDoNo",
        "permissao": "studio"
      },
      "compararVersoes": {
        "metodo": "GET",
        "caminho": "/diff/:kind/:id",
        "entrada": {
          "kind": {
            "tipo": "texto",
            "obrigatorio": true
          },
          "id": {
            "tipo": "texto",
            "obrigatorio": true
          },
          "de": {
            "tipo": "texto",
            "obrigatorio": true
          },
          "para": {
            "tipo": "texto",
            "obrigatorio": true
          }
        },
        "saida": "comparacao",
        "permissao": "studio"
      },
      "listarComentarios": {
        "metodo": "GET",
        "caminho": "/comentarios",
        "entrada": {
          "kind": {
            "tipo": "texto",
            "obrigatorio": true
          },
          "id": {
            "tipo": "texto",
            "obrigatorio": true
          }
        },
        "saida": "listaComentarios",
        "permissao": "studio"
      },
      "comentar": {
        "metodo": "POST",
        "caminho": "/comentarios",
        "entrada": {
          "kind": {
            "tipo": "texto",
            "obrigatorio": true
          },
          "id": {
            "tipo": "texto",
            "obrigatorio": true
          },
          "texto": {
            "tipo": "texto",
            "obrigatorio": true
          },
          "ancora": {
            "tipo": "texto"
          },
          "versao": {
            "tipo": "inteiro"
          },
          "respondeA": {
            "tipo": "uuid"
          }
        },
        "saida": "comentarioCriado",
        "permissao": "studio"
      },
      "resolverComentario": {
        "metodo": "POST",
        "caminho": "/comentarios/:cid/resolver",
        "entrada": {
          "cid": {
            "tipo": "uuid",
            "obrigatorio": true
          },
          "resolvido": {
            "tipo": "booleano",
            "obrigatorio": true
          }
        },
        "saida": "comentarioResolvido",
        "permissao": "studio"
      },
      "previsualizar": {
        "metodo": "POST",
        "caminho": "/previa",
        "entrada": {
          "no": {
            "tipo": "json",
            "obrigatorio": true
          },
          "tema": {
            "tipo": "json"
          },
          "selecionado": {
            "tipo": "texto"
          },
          "modo": {
            "tipo": "texto"
          },
          "dados": {
            "tipo": "json"
          }
        },
        "saida": "previa",
        "permissao": "studio"
      },
      "diagramar": {
        "metodo": "POST",
        "caminho": "/diagrama",
        "entrada": {
          "tipo": {
            "tipo": "texto",
            "obrigatorio": true
          },
          "no": {
            "tipo": "json"
          },
          "selecionado": {
            "tipo": "texto"
          }
        },
        "saida": "diagrama",
        "permissao": "studio"
      },
      "publicarSite": {
        "metodo": "POST",
        "caminho": "/publicar",
        "entrada": {
          "nota": {
            "tipo": "texto"
          }
        },
        "saida": "publicado",
        "permissao": "studio"
      },
      "obterSite": {
        "metodo": "GET",
        "caminho": "/site",
        "saida": "siteConfig",
        "permissao": "studio"
      },
      "definirTemaDoSite": {
        "metodo": "PUT",
        "caminho": "/site",
        "entrada": {
          "tema": {
            "tipo": "texto",
            "obrigatorio": true
          }
        },
        "saida": "siteSalvo",
        "permissao": "studio"
      },
      "listarReleases": {
        "metodo": "GET",
        "caminho": "/releases",
        "saida": "listaReleases",
        "permissao": "studio"
      },
      "voltarRelease": {
        "metodo": "POST",
        "caminho": "/releases/voltar",
        "entrada": {
          "para": {
            "tipo": "inteiro"
          },
          "nota": {
            "tipo": "texto"
          }
        },
        "saida": "voltou",
        "permissao": "studio"
      },
      "compararReleases": {
        "metodo": "GET",
        "caminho": "/releases/diff",
        "entrada": {
          "de": {
            "tipo": "inteiro",
            "obrigatorio": true
          },
          "para": {
            "tipo": "inteiro",
            "obrigatorio": true
          }
        },
        "saida": "diffReleases",
        "permissao": "studio"
      },
      "linkDePreview": {
        "metodo": "POST",
        "caminho": "/releases/preview",
        "entrada": {
          "release": {
            "tipo": "inteiro",
            "obrigatorio": true
          },
          "horas": {
            "tipo": "inteiro"
          }
        },
        "saida": "linkPreview",
        "permissao": "studio"
      },
      "listarAtivos": {
        "metodo": "GET",
        "caminho": "/ativos",
        "saida": "listaAtivos",
        "permissao": "studio"
      },
      "enviarAtivo": {
        "metodo": "POST",
        "caminho": "/ativos",
        "entrada": {
          "nome": {
            "tipo": "texto",
            "obrigatorio": true
          },
          "dados": {
            "tipo": "texto",
            "obrigatorio": true,
            "descricao": "o arquivo em base64"
          }
        },
        "saida": "ativoEnviado",
        "permissao": "studio"
      },
      "removerAtivo": {
        "metodo": "DELETE",
        "caminho": "/ativos/:hash",
        "entrada": {
          "hash": {
            "tipo": "texto",
            "obrigatorio": true
          }
        },
        "saida": "ativoRemovido",
        "permissao": "studio"
      }
    }
  }
}
