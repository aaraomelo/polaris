[
 {
  "kind": "documento",
  "id": "servicos.doc.ordem-servico",
  "versao": "1.0.0",
  "estatuto": "publicado",
  "emit": [
   "html",
   "pdf"
  ],
  "spec": {
   "tamanho": "A4",
   "margem": {
    "topo": 12,
    "direita": 12,
    "baixo": 14,
    "esquerda": 12
   },
   "titulo": "Ordem de Serviço {os.numero}",
   "rodape": "Ordem de Serviço {os.numero} · Página {pagina}/{paginas}",
   "dados": {
    "empresa": {
     "tipo": "json"
    },
    "os": {
     "tipo": "json"
    },
    "cliente": {
     "tipo": "json"
    },
    "itens": {
     "tipo": "lista"
    },
    "totais": {
     "tipo": "json"
    }
   },
   "blocos": [
    {
     "tipo": "barraSecao",
     "variante": "titulo",
     "texto": "Ordem de Serviço"
    },
    {
     "tipo": "colunas",
     "colunas": [
      {
       "flex": 2,
       "blocos": [
        {
         "tipo": "campo",
         "rotulo": "Empresa",
         "valor": "{empresa.nome}",
         "estiloValor": {
          "peso": "negrito",
          "tamanho": 11
         }
        },
        {
         "tipo": "campo",
         "rotulo": "CNPJ",
         "valor": "{empresa.cnpj | cpfcnpj}"
        }
       ]
      },
      {
       "flex": 1,
       "blocos": [
        {
         "tipo": "campo",
         "rotulo": "Telefone",
         "valor": "{empresa.telefone}"
        }
       ]
      }
     ]
    },
    {
     "tipo": "espaco",
     "altura": 6
    },
    {
     "tipo": "colunas",
     "colunas": [
      {
       "blocos": [
        {
         "tipo": "campo",
         "rotulo": "Número",
         "valor": "{os.numero}",
         "estiloValor": {
          "peso": "negrito"
         }
        }
       ]
      },
      {
       "blocos": [
        {
         "tipo": "campo",
         "rotulo": "Aberta em",
         "valor": "{os.abertaEm | data}"
        }
       ]
      },
      {
       "blocos": [
        {
         "tipo": "campo",
         "rotulo": "Situação",
         "valor": "{os.status | upper}"
        }
       ]
      },
      {
       "blocos": [
        {
         "tipo": "campo",
         "rotulo": "Garantia até",
         "valor": "{os.garantiaAte | data}"
        }
       ]
      }
     ]
    },
    {
     "tipo": "barraSecao",
     "texto": "Cliente"
    },
    {
     "tipo": "colunas",
     "colunas": [
      {
       "flex": 2,
       "blocos": [
        {
         "tipo": "campo",
         "rotulo": "Nome",
         "valor": "{cliente.nome}"
        }
       ]
      },
      {
       "flex": 1,
       "blocos": [
        {
         "tipo": "campo",
         "rotulo": "CPF/CNPJ",
         "valor": "{cliente.documento | cpfcnpj}"
        }
       ]
      },
      {
       "flex": 1,
       "blocos": [
        {
         "tipo": "campo",
         "rotulo": "Telefone",
         "valor": "{cliente.telefone}"
        }
       ]
      }
     ]
    },
    {
     "tipo": "barraSecao",
     "texto": "Objeto e defeito relatado"
    },
    {
     "tipo": "paragrafo",
     "texto": "{os.objeto}",
     "peso": "negrito"
    },
    {
     "tipo": "paragrafo",
     "texto": "{os.descricao}"
    },
    {
     "tipo": "barraSecao",
     "texto": "Diagnóstico",
     "se": "os.diagnostico"
    },
    {
     "tipo": "paragrafo",
     "texto": "{os.diagnostico}",
     "se": "os.diagnostico"
    },
    {
     "tipo": "barraSecao",
     "texto": "Peças e serviços"
    },
    {
     "tipo": "tabela",
     "colunas": [
      {
       "cabecalho": "Descrição",
       "flex": 6
      },
      {
       "cabecalho": "Qtd",
       "flex": 1,
       "alinhamento": "direita"
      },
      {
       "cabecalho": "Unitário",
       "flex": 2,
       "alinhamento": "direita"
      },
      {
       "cabecalho": "Total",
       "flex": 2,
       "alinhamento": "direita"
      }
     ],
     "linhasDe": {
      "cada": "itens",
      "como": "i",
      "limite": 500,
      "celulas": [
       {
        "principal": "{i.descricao}",
        "secundario": "{i.tipo | upper}"
       },
       "{i.quantidade | num:3}",
       "{i.precoUnitario | brl}",
       "{i.total | brl}"
      ]
     }
    },
    {
     "tipo": "espaco",
     "altura": 6
    },
    {
     "tipo": "resumo",
     "linhas": [
      {
       "rotulo": "Serviços",
       "valor": "{totais.servicos | brl}"
      },
      {
       "rotulo": "Peças",
       "valor": "{totais.pecas | brl}"
      },
      {
       "rotulo": "Desconto",
       "valor": "{totais.desconto | brl}"
      },
      {
       "rotulo": "Total",
       "valor": "{totais.total | brl}",
       "forte": true
      }
     ]
    },
    {
     "tipo": "espaco",
     "altura": 30
    },
    {
     "tipo": "assinaturas",
     "itens": [
      {
       "rotulo": "{empresa.nome}"
      },
      {
       "rotulo": "{cliente.nome}"
      }
     ]
    }
   ]
  }
 }
]
