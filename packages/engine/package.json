{
  "name": "@polaris/engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "test": "vitest run",
    "tipos": "tsc --noEmit",
    "bench": "tsx bench/ssr.ts",
    "bench:vivo": "tsx bench/vivo.ts",
    "docs:funcoes": "tsx scripts/docs-funcoes.ts",
    "aot": "tsx scripts/aot.ts --",
    "orcamento:navegador": "node bench/navegador/cdp.mjs 3 --verifica",
    "catalogo": "tsx scripts/catalogo.ts --",
    "perfil:lista": "rm -rf .perfil && node --cpu-prof --cpu-prof-dir=.perfil --import tsx bench/perfil-lista.ts && node bench/analisa.mjs .perfil",
    "perfil": "rm -rf .perfil && node --cpu-prof --cpu-prof-dir=.perfil --import tsx bench/perfil.ts && node bench/analisa.mjs .perfil"
  },
  "dependencies": {
    "@polaris/schema": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "quickjs-emscripten": "0.32.0",
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^31.0.1",
    "@types/jsdom": "^30.0.0",
    "tsx": "^4.21.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./cliente": "./src/render/cliente.tsx",
    "./servidor": "./src/render/stream.ts",
    "./sandbox": "./src/sandbox/local.ts",
    "./sandbox-node": "./src/sandbox/worker.ts",
    "./aot": "./src/aot/index.ts",
    "./servidor-vivo": "./src/vivo/stream.ts",
    "./commerce": "./src/commerce/index.ts",
    "./tema": "./src/tema/index.ts",
    "./fontes": "./src/fontes/index.ts",
    "./expr": "./src/expr/index.ts",
    "./formulario": "./src/formulario/index.ts",
    "./tela": "./src/tela/index.ts",
    "./site": "./src/site/index.ts"
  }
}
