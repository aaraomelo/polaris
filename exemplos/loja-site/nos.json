  {
    "kind": "formulario",
    "id": "contato",
    "versao": "1.0.0",
    "estatuto": "publicado",
    "spec": {
      "titulo": "Fale conosco",
      "descricao": "Respondemos em até 1 dia útil.",
      "campos": [
        {
          "nome": "nome",
          "tipo": "texto",
          "rotulo": "Nome completo",
          "obrigatorio": true,
          "normaliza": [
            "aparar",
            "colapsaEspacos"
          ],
          "autocompletar": "name",
          "validacao": {
            "tamanhoMinimo": 3
          },
          "mensagens": {
            "obrigatorio": "Diga como podemos chamar você.",
            "tamanhoMinimo": "O nome precisa de pelo menos {min} letras."
          }
        },
        {
          "nome": "email",
          "tipo": "email",
          "rotulo": "E-mail",
          "obrigatorio": true,
          "autocompletar": "email"
        },
        {
          "nome": "telefone",
          "tipo": "telefone",
          "rotulo": "Telefone",
          "mascara": {
            "padrao": [
              "(00) 0000-0000",
              "(00) 00000-0000"
            ]
          },
          "mensagens": {
            "formato": "Informe o telefone com DDD."
          }
        },
        {
          "nome": "mensagem",
          "tipo": "textoLongo",
          "rotulo": "Mensagem",
          "obrigatorio": true,
          "validacao": {
            "tamanhoMinimo": 10,
            "tamanhoMaximo": 2000
          }
        },
        {
          "nome": "aceite",
          "tipo": "booleano",
          "rotulo": "Concordo com o uso dos dados para contato",
          "obrigatorio": true,
          "mensagens": {
            "obrigatorio": "Precisamos do seu aceite para responder."
          }
        }
      ],
      "envio": {
        "servico": "loja",
        "operacao": "criarContato",
        "args": {
          "nome": "valores.nome",
          "email": "valores.email",
          "telefone": "valores.telefone",
          "mensagem": "valores.mensagem"
        },
        "sucesso": {
          "mensagem": "Mensagem enviada! Obrigado.",
          "limpar": true
        }
      },
      "acoes": [
        {
          "id": "enviar",
          "rotulo": "Enviar mensagem",
          "tipo": "enviar",
          "estilo": "primario"
        },
        {
          "id": "limpar",
          "rotulo": "Limpar",
          "tipo": "limpar",
          "estilo": "secundario"
        }
      ]
    }
  },
